# Copy through scripts/init_local.py; no real secrets committed.
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-never-commit
POSTGRES_ADMIN_PASSWORD=replace
DB_PASSWORD=replace
DATA_MODE=production

# Optional settings (commented out: the defaults apply).
# Local machine only, with DJANGO_ENV=development: sign every visitor in as this account (never a
# staff or superuser account). Do not combine with a dev server reachable from other machines.
# LOCAL_AUTO_LOGIN=local-team
# Extra origins allowed to send forms (a second dev server, a private tunnel), comma-separated.
# CSRF_TRUSTED_ORIGINS=http://localhost:5175
# Public API GET only: optional, exact HTTPS origins with no trailing slash or wildcards.
# In DJANGO_ENV=development only, HTTP localhost/127.0.0.1 is permitted.
# PUBLIC_FRONTEND_ORIGINS=https://atlas.partner.example
# JSON file of the Google Sheets tabs read by `manage.py sync_sheets` (under data/local).
# SHEETS_SYNC_CONFIG=/app/data/local/sheets-sync.json
# Behind a proxy: how many proxies set X-Forwarded-For, and whether TLS ends at the proxy.
# DJANGO_NUM_PROXIES=1
# DJANGO_BEHIND_TLS_PROXY=1
# Rate limits of sign-in and manual imports.
# SIGN_IN_RATE=10/min
# IMPORT_RATE=30/min
# Port of the database seen from the API container.
# DB_PORT=5432
# Frontend dev server (frontend/vite.config.ts): backend to proxy to, extra host names.
# API_TARGET=http://127.0.0.1:8010
# DEV_ALLOWED_HOSTS=
